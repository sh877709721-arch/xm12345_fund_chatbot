{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "files.eol": "\n",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "git.autofetch": true,
  "editor.minimap.enabled": false,
  "explorer.compactFolders": false,
  "CodeFree.index": true,
  "CodeFree.ignoreFileType": [
    ".so",
    ".cache",
    ".exe",
    ".dll",
    ".log"
  ]
}